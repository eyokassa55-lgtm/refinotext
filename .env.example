# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication (wrap keys in quotes in .env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"
CLERK_SECRET_KEY="sk_test_your_key_here"
# Required for /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Neon PostgreSQL
# DATABASE_URL = pooled connection (app runtime)
# DIRECT_URL   = non-pooled connection (Prisma migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Polar Payments (server-side only — never prefix with NEXT_PUBLIC_)
POLAR_ACCESS_TOKEN=
# Real Polar webhook secret. Values like "placeholder" are rejected.
POLAR_WEBHOOK_SECRET=
# "sandbox" or "production"
POLAR_SERVER=sandbox
