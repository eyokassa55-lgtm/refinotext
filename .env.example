# App
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (set this in Vercel — do not use localhost or *.vercel.app):
# NEXT_PUBLIC_APP_URL=https://www.refinotext.com

# Clerk Authentication (wrap keys in quotes in .env.local)
# Local development instance:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"
CLERK_SECRET_KEY="sk_test_your_key_here"
# Vercel Production MUST use the Clerk Production instance (never pk_test / sk_test):
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
# CLERK_SECRET_KEY="sk_live_..."
# Required for /api/webhooks/clerk (use the signing secret from the same instance)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Neon PostgreSQL
# DATABASE_URL = pooled connection (app runtime)
# DIRECT_URL   = non-pooled connection (Prisma migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Vertex AI tuned Gemini model (server-side only — never prefix with NEXT_PUBLIC_)
# Required for Humanize. Paste the exact endpoint from the succeeded tuning job
# named "refino correct" (Vertex AI → Tuning / Agent Platform → job details).
# Do not use gemini-2.5-flash-lite (that is the base model, not the tuned endpoint).
# Do not use the failed "refino text" job.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
TUNED_MODEL_ENDPOINT=
# Alias still accepted:
# VERTEX_AI_TUNED_ENDPOINT=
# Optional alias for location:
# VERTEX_AI_LOCATION=us-central1
# Auth for Vercel / other hosts without Application Default Credentials:
# paste the full service account JSON as one line, or set email + private key.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# Local ADC alternative: GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# Google Gemini API (server-side only — never prefix with NEXT_PUBLIC_)
# Not used for Humanize unless ALLOW_BASE_GEMINI_FALLBACK=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# ALLOW_BASE_GEMINI_FALLBACK=false

# Fireworks (server-side only — never prefix with NEXT_PUBLIC_)
# Not used by Humanize. Vertex is the primary model.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=

# Polar Payments (server-side only — never prefix with NEXT_PUBLIC_)
POLAR_ACCESS_TOKEN=
# Real Polar webhook secret from the same Polar org as POLAR_SERVER. Values like "placeholder" are rejected.
POLAR_WEBHOOK_SECRET=
# "sandbox" or "production"
POLAR_SERVER=sandbox
# Production webhook URL Polar should call (prefer www; apex may 308):
# https://www.refinotext.com/api/webhooks/polar
