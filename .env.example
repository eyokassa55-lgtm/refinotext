# App
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (set this in Vercel — do not use localhost or *.vercel.app):
# NEXT_PUBLIC_APP_URL=https://refinotext.com

# Clerk Authentication (wrap keys in quotes in .env.local)
# Local development instance:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"
CLERK_SECRET_KEY="sk_test_your_key_here"
# Vercel Production MUST use the Clerk Production instance (never pk_test / sk_test):
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
# CLERK_SECRET_KEY="sk_live_..."
# Required for /api/webhooks/clerk (use the signing secret from the same instance)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Neon PostgreSQL
# DATABASE_URL = pooled connection (app runtime)
# DIRECT_URL   = non-pooled connection (Prisma migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Fireworks (server-side only — never prefix with NEXT_PUBLIC_)
# Used first when FIREWORKS_MODEL is set. Gemini is the fallback.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=

# Polar Payments (server-side only — never prefix with NEXT_PUBLIC_)
POLAR_ACCESS_TOKEN=
# Real Polar webhook secret from the same Polar org as POLAR_SERVER. Values like "placeholder" are rejected.
POLAR_WEBHOOK_SECRET=
# "sandbox" or "production"
POLAR_SERVER=sandbox
# Production webhook URL Polar should call (do not use a URL that 308s):
# https://refinotext.com/api/webhooks/polar
